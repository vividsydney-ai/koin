{
  "name": "koin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky",
    "test:watch": "vitest",
    "loop:prompt": "bash scripts/agent-loop.sh --print",
    "loop:codex": "bash scripts/agent-loop.sh --agent codex",
    "loop:claude": "bash scripts/agent-loop.sh --agent claude",
    "loop:kimi": "bash scripts/agent-loop.sh --agent kimi",
    "verify:loop": "bash scripts/verify-loop.sh",
    "loop:init": "bash scripts/loop-init.sh",
    "loop:gates": "bash scripts/gate-runner.sh",
    "loop:budget": "bash scripts/budget-check.sh",
    "loop:security": "bash scripts/security-loop.sh",
    "loop:design-drift": "bash scripts/design-drift-check.sh",
    "loop:cap-sync": "bash scripts/capacitor-sync-check.sh",
    "loop:reflexion": "bash scripts/reflexion-search.sh",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:gen-types": "supabase gen types typescript --linked > types/supabase.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "react-hook-form": "^7.80.0",
    "supabase": "^2.109.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'pnpm run type-check'"
    ]
  }
}
